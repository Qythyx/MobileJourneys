<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<RootNamespace>MobileJourneys</RootNamespace>
		<AssemblyName>MobileJourneys</AssemblyName>
		<IsPackable>false</IsPackable>
		<!-- This is a library, not a test runner. `dotnet test` walks the slnx and tries
		     to run every project; setting these to false makes it skip us. -->
		<IsTestProject>false</IsTestProject>
		<IsTestingPlatformApplication>false</IsTestingPlatformApplication>
		<!-- MinVer derives Version / FileVersion / InformationalVersion from the latest
		     git tag at build time. See CLAUDE.md "Versioning" for the release workflow. -->
		<MinVerDefaultPreReleaseIdentifiers>alpha.0</MinVerDefaultPreReleaseIdentifiers>
	</PropertyGroup>
	<ItemGroup>
		<PackageReference Include="Appium.WebDriver" />
		<PackageReference Include="Codeuctivity.ImageSharpCompare" />
		<PackageReference Include="MinVer" PrivateAssets="All" />
		<PackageReference Include="SixLabors.ImageSharp" />
		<PackageReference Include="Spectre.Console" />
	</ItemGroup>
	<ItemGroup>
		<InternalsVisibleTo Include="MobileJourneys.Tests" />
	</ItemGroup>
	<ItemGroup>
		<EmbeddedResource Include="Viewer/index.html" />
	</ItemGroup>
</Project>
